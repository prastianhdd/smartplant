{
  "name": "smartplant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply smartplant --local",
    "db:remote": "wrangler d1 migrations apply smartplant --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
